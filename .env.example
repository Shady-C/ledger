# Bind published development ports to loopback by default. Set 0.0.0.0 only
# when remote access is intentional and the host is otherwise protected.
BIND_ADDRESS=127.0.0.1

# PostgreSQL (development defaults only; replace passwords outside local use)
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ledger:ledger_dev_password@localhost:5432/ledger?sslmode=disable
DATABASE_URL_DOCKER=postgresql://ledger:ledger_dev_password@postgres:5432/ledger?sslmode=disable
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# MinIO server and S3-compatible application credentials
MINIO_ROOT_USER=ledger_admin
MINIO_ROOT_PASSWORD=ledger_minio_admin_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ACCESS_KEY=ledger_app
S3_SECRET_KEY=ledger_minio_app_password
S3_BUCKET=ledger-statements
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT_DOCKER=http://minio:9000
S3_FORCE_PATH_STYLE=true

# Exactly 64 hexadecimal characters (32 bytes) for AES-256-GCM.
# INSECURE LOCAL DEVELOPMENT KEY: replace it everywhere outside local use.
STATEMENT_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# Web service
WEB_PORT=3000
ORIGIN=http://localhost:3000
PUBLIC_BASE_CURRENCY=CAD
UPLOAD_MAX_FILES=10
UPLOAD_MAX_FILE_BYTES=15728640
UPLOAD_MAX_TOTAL_BYTES=41943040
BODY_SIZE_LIMIT=52428800

# Worker
BASE_CURRENCY=CAD
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_JOB_TIMEOUT_SECONDS=900
# `stub` is an explicit test/smoke mode with deterministic AI and FX providers.
WORKER_PROVIDER_MODE=live
LOG_LEVEL=INFO

# Phase 1 FX provider. Frankfurter v2 requires no key and can be replaced by a
# self-hosted compatible endpoint. Rates older than this fail closed.
FX_PROVIDER_URL=https://api.frankfurter.dev/v2
FX_MAX_STALENESS_DAYS=7

# Phase 1 AI provider. With a blank key, deterministic ingestion remains
# available and categorization jobs report that AI is not configured.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_CAPABLE=claude-sonnet-5
AI_CATEGORY_AUTO_APPLY_THRESHOLD=0.85

# Phase 3 Ask is a separate opt-in because question text is sent to the
# configured provider. Exact ledger results and evidence remain local.
ASK_ENABLED=false
ASK_PROVIDER_MODE=live
ASK_PROVIDER_TIMEOUT_MS=20000
