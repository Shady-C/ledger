    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.20.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.1",
    "@types/pg": "^8.11.11",
    "jsdom": "29.1.1",
